# Copy to apps/cms/.env and fill in. Generate secrets with: openssl rand -base64 32
# Comment out or delete any key you leave empty: Strapi treats KEY= as set, which overrides the default.
HOST=0.0.0.0
PORT=1337
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=
# Postgres (docker compose locally, Render Postgres in Phase A, RDS Postgres 16 in Phase B)
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SCHEMA=
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=
DATABASE_POOL_MIN=
DATABASE_POOL_MAX=
# Behind a TLS proxy (Render, AWS): true, so secure admin cookies work. PUBLIC_URL = public origin.
IS_PROXIED=
PUBLIC_URL=
# Admin IP allow-list (TDD §5.4). IPs/CIDRs, comma-separated. Everything but /api/*, /uploads/*
# and /_health is limited to it. Enforced by default when NODE_ENV=production (empty = blocked).
ADMIN_IP_ALLOWLIST=
# x-forwarded-for (default; ADMIN_IP_TRUSTED_HOPS from the right, 2 on Render), cf-connecting-ip, or socket (local)
ADMIN_IP_HEADER=
ADMIN_IP_TRUSTED_HOPS=
ADMIN_IP_ENFORCE=
# dev, staging or prod on hosted environments; leave empty locally
DEPLOY_ENV=
# true = admin open to every IP except the first-admin sign-up. Only allowed with DEPLOY_ENV=dev (TDD D31)
ADMIN_IP_OPEN=
# Admin session lifetimes in seconds (defaults: refresh 30 days, session 1 day)
ADMIN_MAX_REFRESH_TOKEN_LIFESPAN=
ADMIN_MAX_SESSION_LIFESPAN=
# Strapi admin marketing prompts (default off)
FLAG_NPS=
FLAG_PROMOTE_EE=
# Baked into the admin bundle at build time; rebuild per environment
ADMIN_PATH=
STRAPI_ADMIN_BACKEND_URL=
STRAPI_TELEMETRY_DISABLED=
