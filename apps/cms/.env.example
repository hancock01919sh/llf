# Copy to apps/cms/.env and fill in. Generate secrets with: openssl rand -base64 32
HOST=0.0.0.0
PORT=1337
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=
# Postgres (docker compose locally, Render Postgres in Phase A, RDS Postgres 16 in Phase B)
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SCHEMA=
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=
DATABASE_POOL_MIN=
DATABASE_POOL_MAX=
# Admin session lifetimes in seconds (defaults: refresh 30 days, session 1 day)
ADMIN_MAX_REFRESH_TOKEN_LIFESPAN=
ADMIN_MAX_SESSION_LIFESPAN=
# Strapi admin marketing prompts (default off)
FLAG_NPS=
FLAG_PROMOTE_EE=
# Baked into the admin bundle at build time; rebuild per environment
ADMIN_PATH=
STRAPI_ADMIN_BACKEND_URL=
STRAPI_TELEMETRY_DISABLED=
