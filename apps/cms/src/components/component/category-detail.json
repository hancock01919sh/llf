{
  "collectionName": "components_component_category_details",
  "info": {
    "displayName": "Category Detail"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": false
    },
    "description": {
      "type": "text",
      "required": false
    },
    "image": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "subTitle": {
      "type": "string",
      "required": false
    },
    "statement": {
      "type": "blocks"
    },
    "button": {
      "type": "component",
      "component": "shared.links",
      "repeatable": false
    },
    "popup": {
      "type": "component",
      "component": "component.tips-popup",
      "repeatable": false
    },
    "isFullwidth": {
      "type": "boolean",
      "default": false
    },
    "backgroundColor": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "forest"
      ]
    }
  },
  "config": {}
}
