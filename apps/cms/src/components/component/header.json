{
  "collectionName": "components_component_headers",
  "info": {
    "displayName": "Header"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "subTitle": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "backgroundColor": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "terra",
        "forest"
      ]
    },
    "addBackgroundColor": {
      "type": "boolean",
      "default": false
    },
    "positionOfAddingBgColor": {
      "type": "enumeration",
      "enum": [
        "up",
        "down"
      ]
    },
    "isFullwidth": {
      "type": "boolean",
      "default": false
    }
  },
  "config": {}
}
