{
  "collectionName": "components_component_content_spotlights",
  "info": {
    "displayName": "Content Spotlight"
  },
  "options": {},
  "attributes": {
    "description": {
      "type": "text",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "backgroundColor": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "paper",
        "sand"
      ]
    },
    "makeImageLeft": {
      "type": "boolean",
      "default": false
    },
    "isFullwidth": {
      "type": "boolean",
      "default": false
    },
    "title": {
      "type": "component",
      "component": "shared.title",
      "repeatable": false,
      "required": true
    }
  },
  "config": {}
}
