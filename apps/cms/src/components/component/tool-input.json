{
  "collectionName": "components_component_tool_inputs",
  "info": {
    "displayName": "Tool Input"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "subTitle": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "cardTitle": {
      "type": "string",
      "required": true
    },
    "cardDescription": {
      "type": "text"
    },
    "cards": {
      "type": "component",
      "component": "shared.input-card",
      "repeatable": true
    },
    "placeholder": {
      "type": "string"
    },
    "copy": {
      "type": "string"
    },
    "button": {
      "type": "component",
      "component": "shared.links",
      "repeatable": true
    },
    "backgroundColor": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "forest",
        "paper"
      ]
    },
    "isFullwidth": {
      "type": "boolean",
      "default": false
    }
  },
  "config": {}
}
