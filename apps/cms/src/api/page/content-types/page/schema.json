{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "path": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "template": {
      "type": "enumeration",
      "enum": ["generic", "home", "find-my-tips", "library"],
      "default": "generic",
      "required": true
    },
    "hero": {
      "type": "component",
      "component": "component.hero",
      "repeatable": false,
      "conditions": {
        "visible": {
          "==": [{ "var": "template" }, "home"]
        }
      }
    },
    "intro": {
      "type": "blocks",
      "conditions": {
        "visible": {
          "==": [{ "var": "template" }, "home"]
        }
      }
    },
    "featured": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "conditions": {
        "visible": {
          "==": [{ "var": "template" }, "home"]
        }
      }
    },
    "tool": {
      "type": "component",
      "component": "custom.tool",
      "repeatable": false,
      "conditions": {
        "visible": {
          "==": [{ "var": "template" }, "find-my-tips"]
        }
      }
    },
    "main": {
      "type": "dynamiczone",
      "components": [
        "component.teaser",
        "component.link-list",
        "component.hero",
        "custom.tool",
        "custom.search",
        "component.carousel",
        "custom.tip-list"
      ],
      "conditions": {
        "visible": {
          "in": [{ "var": "template" }, ["generic", "home"]]
        }
      }
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
