{
  "kind": "collectionType",
  "collectionName": "ingredient_types",
  "info": {
    "singularName": "ingredient-type",
    "pluralName": "ingredient-types",
    "displayName": "Ingredient Type"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true
    },
    "ingredients": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ingredient.ingredient",
      "mappedBy": "ingredient_type"
    },
    "emoji": {
      "type": "string",
      "required": true
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
