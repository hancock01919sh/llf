    {
      "__component": "component.5050-text-and-image",
      "id": 65,
      "description": "Store it differently. Freeze it before it turns. Use the part you were about to throw away. None of it takes more time than what you're doing now.",
      "makeImageLeft": false,
      "addBackgroundColor": null,
      "positionOfAddingBgColor": null,
      "isFullwidth": false,
      "backgroundColor": "paper",
      "title": {
        "id": 157,
        "copy": "small changes, real impact",
        "header": "h2"
      },
      "image": {
        "id": 80,
