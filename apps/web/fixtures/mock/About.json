          "ext": ".jpg",
          "alternativeText": "carrot",
          "height": 2021,
          "width": 3032,
          "size": 1749.75
        },
        {
          "id": 38,
          "documentId": "fu2xudky967owmc3xtrkxfju",
          "url": "/uploads/4cc23f6b115d854e524a9a3120e50e76bcadc0b7_a1d52fece5.jpg",
          "ext": ".jpg",
