              }
            },
            {
              "id": 70,
              "documentId": "x9bzple5pdfp6fpda68w5m8k",
              "title": "Leftover cooked steak dries out from reheating uncovered",
              "description": "Slice thin and reheat in a covered pan with a splash of stock or sauce. Reheating dry is why leftover steak has a bad reputation.",
              "createdAt": "2026-10-30T08:40:59.576Z",
