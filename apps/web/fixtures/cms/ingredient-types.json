                        },
                        {
                            "id": 18,
                            "documentId": "led2f0kqh4wros81w969ik53",
                            "title": "Portion chicken when you get home, then freeze what you won't cook in two days",
                            "description": "Raw chicken has a short fridge window. Portioning immediately, then freezing keeps them at peak quality and means you're only thawing what you actually need",
                            "createdAt": "2026-10-30T08:35:44.832Z",
                            "updatedAt": "2026-10-30T08:35:44.832Z",
