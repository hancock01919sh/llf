          "tips": [
            {
              "id": 78,
              "documentId": "zjlse35oaxqohnc5k2mhjj4q",
              "title": "The cheaper the cut, the more forgiving it is to cook",
              "description": "Chuck, brisket, and stew meat are built for low, slow cooking with a wide margin for error.",
              "createdAt": "2026-10-26T07:43:11.623Z",
              "updatedAt": "2026-10-26T07:43:11.623Z",
