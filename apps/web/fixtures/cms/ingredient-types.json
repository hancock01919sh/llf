        {
          "id": 87,
          "documentId": "b44wmv61zo4191m5h7m8l43c",
          "title": "Pork",
          "synonyms": null,
          "wasted": 3,
          "createdAt": "2026-10-30T08:43:29.821Z",
          "updatedAt": "2026-10-30T08:43:29.821Z",
          "publishedAt": "2026-10-30T08:43:29.849Z",
          "image": null,
          "tips": [
            {
              "id": 72,
              "documentId": "l0ogv6utari179mlldr5avdr",
              "title": "Pork shoulder and butt are forgiving cuts you can buy",
              "description": "Designed for low, slow cooking with a wide margin for error. Unlike loin or chops, they're hard to overcook and hold up longer in the fridge before cooking.",
              "createdAt": "2026-10-30T08:44:33.981Z",
              "updatedAt": "2026-10-30T08:44:33.981Z",
              "publishedAt": "2026-10-30T08:44:34.031Z",
              "tip_type": {
                "id": 22,
                "documentId": "jx1ssjev8r4nb2kyc3fn9hde",
                "title": "Buy it",
                "createdAt": "2026-10-16T09:40:52.919Z",
                "updatedAt": "2026-10-16T09:40:53.630Z",
                "publishedAt": "2026-10-16T09:40:53.646Z"
              }
            },
            {
              "id": 90,
              "documentId": "bdima3bi9n1iyvhuibvvjhbq",
              "title": "Pork on its last day belongs in a covered pan with liquid",
              "description": "Stock, wine, or even water with aromatics — low heat, covered, for an hour. The same process that makes tough cuts tender rescues ones that have been sitting too long.",
              "createdAt": "2026-10-30T08:46:12.907Z",
              "updatedAt": "2026-10-30T08:46:12.907Z",
              "publishedAt": "2026-10-30T08:46:12.974Z",
              "tip_type": {
                "id": 24,
                "documentId": "wy46qcysn8mub06x91za7imk",
                "title": "Rescue it",
                "createdAt": "2026-10-16T03:44:08.725Z",
                "updatedAt": "2026-11-03T03:26:37.905Z",
                "publishedAt": "2026-11-03T03:26:37.920Z"
              }
            },
            {
              "id": 92,
              "documentId": "xz9mytyp7csyw4cbxm64vmn2",
              "title": "Pork is one of the more versatile leftovers",
              "description": "It works cold or warm, in almost any cuisine — tacos, fried rice, grain bowls, noodle soups. Most leftovers narrow your options. Leftover pork opens them up.",
              "createdAt": "2026-10-30T08:45:10.940Z",
              "updatedAt": "2026-10-30T08:47:00.288Z",
              "publishedAt": "2026-10-30T08:47:00.376Z",
