          "tips": [
            {
              "id": 80,
              "documentId": "djsjubgenqdipoja5z0u8ta0",
              "title": "Check your household weekly consumption before sizing up to a gallon",
              "description": "A smaller carton finished on time beats a larger one that ends up down the drain. Buy to match how much you actually go through, not what feels like the better deal per ounce.",
              "createdAt": "2026-10-26T07:50:25.858Z",
              "updatedAt": "2026-10-26T07:50:25.858Z",
              "publishedAt": "2026-10-26T07:50:25.916Z",
