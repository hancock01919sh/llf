                    "tips": [
                        {
                            "id": 8,
                            "documentId": "fwh360l3hc2b9xcr5eg0c0j9",
                            "title": "Bone-in thighs do more for less money",
                            "description": "They generally cost less per pound, stay juicy past the point where breast dries out, and the bones make stock. Worth reconsidering as your default cut.",
                            "createdAt": "2026-10-26T07:38:48.929Z",
                            "updatedAt": "2026-10-26T07:38:48.929Z",
                            "publishedAt": "2026-10-26T07:38:49.354Z",
