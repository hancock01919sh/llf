        {
          "id": 122,
          "documentId": "ze0vrm7u62kue30a9cftvcxi",
          "title": "Bell peppers",
          "synonyms": "Red pepper, Green pepper, Yellow pepper, Orange pepper, Sweet peppers",
          "wasted": 3,
          "createdAt": "2026-10-27T06:33:23.208Z",
          "updatedAt": "2026-11-13T07:34:41.004Z",
          "publishedAt": "2026-11-13T07:34:41.044Z",
          "image": null,
          "tips": [
            {
              "id": 94,
              "documentId": "wm2jxb5usb6rmppg71oqh7rn",
              "title": "Bulk pepper packs are cheaper — but only if you have a plan for all of them",
              "description": "If you're buying a multicolor pack, separate them out when you get home and store them loose in the crisper rather than packed together. One soft pepper speeds up the rest.",
              "createdAt": "2026-10-30T08:51:32.339Z",
              "updatedAt": "2026-10-30T08:51:32.339Z",
              "publishedAt": "2026-10-30T08:51:32.388Z",
              "tip_type": {
                "id": 22,
                "documentId": "jx1ssjev8r4nb2kyc3fn9hde",
                "title": "Buy it",
                "createdAt": "2026-10-16T09:40:52.919Z",
                "updatedAt": "2026-10-16T09:40:53.630Z",
                "publishedAt": "2026-10-16T09:40:53.646Z"
              }
            },
            {
              "id": 96,
              "documentId": "jkdih7avq1zmfak3l8q03qll",
              "title": "Peppers go mushy and slimy from moisture, not age",
              "description": "Keep them dry and unwashed in the crisper drawer until you're ready to use them. Sealed airtight, condensation builds up against the skin and speeds up deterioration.",
              "createdAt": "2026-10-30T08:52:24.240Z",
              "updatedAt": "2026-10-30T08:52:40.046Z",
              "publishedAt": "2026-10-30T08:52:40.104Z",
              "tip_type": {
                "id": 20,
                "documentId": "l5j2f7d2oviv5uybla6f46if",
                "title": "Store it",
                "createdAt": "2026-10-16T09:40:25.625Z",
                "updatedAt": "2026-10-16T09:40:26.364Z",
                "publishedAt": "2026-10-16T09:40:26.374Z"
              }
            },
            {
              "id": 98,
              "documentId": "qotbstqchqya7h7hxpkm0h38",
              "title": "Roast peppers that are starting to soften before they go any further",
              "description": "Soft peppers caramelize better than firm ones at high heat. Slice, toss with oil, and roast at 425°F until charred at the edges — they become a completely different ingredient.",
              "createdAt": "2026-10-30T08:53:19.975Z",
              "updatedAt": "2026-10-30T08:53:19.975Z",
