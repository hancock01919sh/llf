                "updatedAt": "2026-10-16T09:40:53.630Z",
                "publishedAt": "2026-10-16T09:40:53.646Z"
              }
            },
            {
              "id": 82,
              "documentId": "fv627i1ovkku18903ckgfann",
              "title": "Milk doesn't belong in the fridge door",
              "description": "The door is the warmest spot and fluctuates with every open and close. Keep it on a middle or bottom shelf toward the back where the temperature stays consistently cold.",
              "createdAt": "2026-10-26T07:51:19.663Z",
              "updatedAt": "2026-10-26T07:51:37.555Z",
              "publishedAt": "2026-10-26T07:51:37.757Z",
              "tip_type": {
                "id": 20,
                "documentId": "l5j2f7d2oviv5uybla6f46if",
                "title": "Store it",
                "createdAt": "2026-10-16T09:40:25.625Z",
                "updatedAt": "2026-10-16T09:40:26.364Z",
                "publishedAt": "2026-10-16T09:40:26.374Z"
              }
            },
            {
              "id": 84,
              "documentId": "ode6rxr8z58obg8w1wl272g9",
              "title": "Milk that's just past its label date but still smells fine works perfectly in cooking",
              "description": "Pancakes, muffins, and sauces are all good uses — heat and other ingredients do the rest. Save the freshest milk for drinking straight and use the older carton for cooking first.",
              "createdAt": "2026-10-30T08:33:49.750Z",
              "updatedAt": "2026-10-30T08:33:49.750Z",
