{
  "name": "@llf/gemini-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Dev-only Gemini relay on Render for developers who can't reach Google from mainland China (TDD D38)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@llf/config": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
