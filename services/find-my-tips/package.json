{
  "name": "@llf/find-my-tips",
  "version": "0.1.0",
  "private": true,
  "description": "Find My Tips tool API: extraction, URL fetch, catalog matching (TDD §7)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "eval": "tsx --env-file-if-exists=../../.env src/eval/run.ts",
    "arena": "tsx --env-file-if-exists=../../.env src/eval/arena-run.ts",
    "rescore": "tsx src/eval/rescore-run.ts",
    "soak": "tsx --env-file-if-exists=../../.env src/eval/soak-run.ts",
    "catalog-diff": "tsx src/eval/catalog-diff-run.ts"
  },
  "dependencies": {
    "@llf/contracts": "workspace:*",
    "@llf/matching": "workspace:*",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@llf/config": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
