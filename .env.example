# Root env for local dev. Copy to .env (git-ignored) and fill in what you need.
# Keys only — never commit values. Deployed environments use Render env groups / AWS Secrets Manager.
# Every key is optional: commented lines show the default. Uncomment to override.
# The CMS has its own apps/cms/.env (created by `pnpm dev` / `pnpm dev:cms`; see apps/cms/.env.example).

# --- Docker / local Postgres --------------------------------------------------
# Host port for docker compose Postgres. Use 5433 if Homebrew Postgres holds 5432.
# POSTGRES_PORT=5432

# --- Web (apps/web) ------------------------------------------------------------
# Content source at build time: CMS_FIXTURES=1 builds from apps/web/fixtures/cms,
# otherwise CMS_URL + CMS_TOKEN (read-only Strapi API token) are required.
# CMS_FIXTURES=1
# CMS_URL=http://localhost:1337
CMS_TOKEN=
# `pnpm seed` only: Strapi write token (full access). Revoke it after seeding (TDD §5.5).
# CMS_SEED_TOKEN=
# Origin for relative Strapi upload URLs. Defaults to CMS_URL.
# CMS_MEDIA_URL=
# Canonical origin for metadata, sitemap and JSON-LD.
# SITE_URL=https://longlivefood.org
# local | dev | staging | prod. Only `prod` is indexable (robots, X-Robots-Tag).
# SITE_ENV=local
# GTM container ID. Unset = no analytics scripts load.
# NEXT_PUBLIC_GTM_ID=
# Find My Tips upstream for the /api/find-tips proxy. Defaults to http://localhost:$TOOL_PORT.
# TIPS_URL=
# "user:pass" to put the web server behind Basic auth (dev/staging previews).
# BASIC_AUTH=
# Playwright web server port.
# E2E_PORT=3100
# Don't set PORT here: web and the tool both read it. Web defaults to 3000; use TOOL_PORT for the tool.

# --- Find My Tips (services/find-my-tips) -------------------------------------
# Port for the tool service (wins over PORT). Web derives TIPS_URL from it.
# TOOL_PORT=8787
# live | jsonld-only | off
# FIND_TIPS_MODE=live
# mock | anthropic | gemini | openai | bedrock. Default mock. Locally you may use a live
# provider with ddd's dev key (TDD D33); CI always stays on mock (AGENTS.md).
# AI_PROVIDER=mock
# AI_MODEL=mock-1
# PROMPT_VERSION=p1
# Dev only (OPEN-2): ddd's Anthropic key, for local dev (D33), Render dev and `pnpm eval`. Never commit a value.
# ANTHROPIC_API_KEY=
# TBWA's capped OpenAI test key (Render dev and `pnpm arena` only). Never commit a value.
# OPENAI_API_KEY=
# OpenAI reasoning effort; Gemini thinking budget: none | minimal | low | medium | high. Unset = provider default.
# AI_REASONING_EFFORT=
# TODO(OPEN-1): Bedrock key names land with its adapter (extract/stubs.ts).
# ddd's own Gemini key (dev/eval only, pending acceptance; TDD D25): local dev (D33), Render dev and `pnpm arena`.
# Test data only. Never commit a value.
# GEMINI_API_KEY=
# Proxies in front of the tool that append to X-Forwarded-For (1 on Render dev). 0 = socket address.
# TRUSTED_PROXY_HOPS=0
# Catalog source: a Strapi catalog URL or a local JSON file. Defaults to the bundled fixture.
# CATALOG_URL=
# CATALOG_FILE=
# CATALOG_REFRESH_MS=60000
# QUOTA_DAILY_MODEL_CALLS=3000
# RATE_LIMIT_WINDOW_MS=300000
# RATE_LIMIT_URL=30
# RATE_LIMIT_MODEL=10
# URL_CACHE_TTL_MS=86400000
# MODEL_TIMEOUT_MS=15000
# HANDLER_TIMEOUT_MS=25000
